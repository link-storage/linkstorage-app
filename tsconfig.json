{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["ES2015", "es6"],
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/src/*": ["./src/*"],
      "@/public/*": ["./public/*"]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    ".eslintrc.js",
    ".prettierrc.js"
  ]
}